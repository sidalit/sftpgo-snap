#!/bin/sh
# Start the service with the settings from `snap set sftpgo ...`.
set -eu

. "$SNAP/bin/sftpgo-env"

# Create the default folder for users' files; another one must already exist,
# so that an unmounted drive stops the service instead of filling this disk.
mkdir -p "$SNAP_COMMON/data"
if [ ! -d "$SFTPGO_DATA_PROVIDER__USERS_BASE_DIR" ]; then
  echo "users-base-dir $SFTPGO_DATA_PROVIDER__USERS_BASE_DIR does not exist or cannot be reached" >&2
  exit 1
fi

cd "$SNAP_COMMON"
# Log to the journal. SFTPGO_LOG_FILE_PATH in an env.d file selects a log file.
exec "$SNAP/bin/sftpgo" serve --log-file-path ''

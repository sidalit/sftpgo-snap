#!/bin/sh
set -eu

. "$SNAP/bin/sftpgo-env"

# An unmounted drive must stop the service, not fill this disk.
mkdir -p "$SNAP_COMMON/data"
if [ ! -d "$SFTPGO_DATA_PROVIDER__USERS_BASE_DIR" ]; then
  echo "users-base-dir $SFTPGO_DATA_PROVIDER__USERS_BASE_DIR does not exist or cannot be reached" >&2
  exit 1
fi

cd "$SNAP_COMMON"
# An empty path logs to the journal.
exec "$SNAP/bin/sftpgo" serve --log-file-path ''
